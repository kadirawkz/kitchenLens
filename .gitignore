# ==============================================================================
# KitchenLens Repository Gitignore Configuration
# ==============================================================================

# --- Environments & Secrets ---
# Exclude local environment files containing keys and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
*.pem
*.key
*.cert
secrets.json

# --- Docker & Database Data ---
# Exclude persistent local volumes and data files
postgres_data/
chroma_data/
backend/chroma_data/
backend/postgres_data/
db_data/
*.db
*.sqlite
*.sqlite3

# --- Python / FastAPI Backend ---
# Compiled python files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
ENV/local/
ENV/bin/
virtualenv/
pip-log.txt
pip-delete-this-directory.txt

# Testing, reports & coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruamel_cache/
.mypy_cache/
.ruff_cache/

# Local media / file uploads
backend/app/uploads/
backend/uploads/
uploads/
temp_media/

# --- Node / React Frontend ---
# Dependencies
node_modules/
jspm_packages/

# Compiled frontend bundle
dist/
dist-ssr/
out/
build-frontend/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches & Tooling Outputs
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.cache/
.vite/

# --- IDEs, Editors & Workspaces ---
# VS Code
.vscode/*
!.vscode/settings.json

# IntelliJ (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Other IDE files
.project
.pydevproject
.settings/

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

